+{%- comment -%}
+  Homepage JSON-LD (index.html only). The Organization, AutoRental and WebSite nodes use the
+  same @ids and the same _data/site.yml values as _includes/seo/schema-graph.html (non-home
+  pages), so Google sees one entity. No Review/AggregateRating (self-serving, not on the page),
+  no postal code, sameAs = social.facebook + social.instagram only (confirmed profiles).
+  FAQ text comes from _data/home_faq.yml, the same source as the visible FAQ.
+{%- endcomment -%}
+{%- assign cfg = site.data.site -%}
+{%- assign sc = cfg.schema -%}
+{%- assign home_url = '/' | absolute_url -%}
+{%- assign org_id = home_url | append: '#organization' -%}
+{%- assign biz_id = home_url | append: '#localbusiness' -%}
+{%- assign site_id = home_url | append: '#website' -%}
+{%- assign logo_id = home_url | append: '#logo' -%}
+{%- assign logo_abs = cfg.brand.logo_square | absolute_url -%}
+{%- capture same_as -%}[{{ cfg.social.facebook | jsonify }},{{ cfg.social.instagram | jsonify }}]{%- endcapture -%}
+<script type="application/ld+json">
+{"@context":"https://schema.org","@graph":[
+{"@type":"Organization","@id":{{ org_id | jsonify }},"name":{{ cfg.brand.name | jsonify }},"alternateName":{{ sc.alternate_name | jsonify }},"url":{{ home_url | jsonify }},"logo":{"@type":"ImageObject","@id":{{ logo_id | jsonify }},"url":{{ logo_abs | jsonify }},"contentUrl":{{ logo_abs | jsonify }},"width":{{ cfg.brand.logo_square_size }},"height":{{ cfg.brand.logo_square_size }}},"image":{"@id":{{ logo_id | jsonify }}},"email":{{ cfg.contact.email | jsonify }},"telephone":{{ cfg.contact.phone_e164 | jsonify }},"contactPoint":{"@type":"ContactPoint","telephone":{{ cfg.contact.phone_e164 | jsonify }},"email":{{ cfg.contact.email | jsonify }},"contactType":"customer service","areaServed":"VN","availableLanguage":["vi"]},"sameAs":{{ same_as }}},
+{"@type":{{ sc.business_type | default: 'AutoRental' | jsonify }},"@id":{{ biz_id | jsonify }},"name":{{ cfg.brand.name | jsonify }},"alternateName":{{ sc.alternate_name | jsonify }},"description":{{ sc.description | jsonify }},"url":{{ home_url | jsonify }},"image":{{ logo_abs | jsonify }},"logo":{"@id":{{ logo_id | jsonify }}},"telephone":{{ cfg.contact.phone_e164 | jsonify }},"email":{{ cfg.contact.email | jsonify }},"priceRange":{{ sc.price_range | jsonify }},"currenciesAccepted":"VND","address":{"@type":"PostalAddress","streetAddress":{{ cfg.contact.street_address | jsonify }},"addressLocality":{{ cfg.contact.address_locality | jsonify }},"addressRegion":{{ cfg.contact.address_region | jsonify }},"addressCountry":{{ cfg.contact.address_country | jsonify }}},"geo":{"@type":"GeoCoordinates","latitude":{{ cfg.contact.latitude }},"longitude":{{ cfg.contact.longitude }}},"hasMap":{{ cfg.contact.map_url | jsonify }},"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],"opens":{{ cfg.contact.opens | jsonify }},"closes":{{ cfg.contact.closes | jsonify }}}],"areaServed":{"@type":"City","name":"Hà Nội"},"parentOrganization":{"@id":{{ org_id | jsonify }}},"sameAs":{{ same_as }}},
+{"@type":"WebSite","@id":{{ site_id | jsonify }},"url":{{ home_url | jsonify }},"name":{{ cfg.brand.name | jsonify }},"inLanguage":"vi","publisher":{"@id":{{ org_id | jsonify }}}},
+{"@type":"Service","@id":{{ home_url | append: '#service' | jsonify }},"serviceType":"Cho thuê xe máy theo ngày, tuần, tháng","provider":{"@id":{{ biz_id | jsonify }}},"areaServed":{"@type":"City","name":"Hà Nội"},"description":{{ site.data.prices.policy_text | jsonify }}},
+{"@type":"FAQPage","@id":{{ home_url | append: '#webpage' | jsonify }},"url":{{ home_url | jsonify }},"inLanguage":"vi","isPartOf":{"@id":{{ site_id | jsonify }}},"about":{"@id":{{ biz_id | jsonify }}},"publisher":{"@id":{{ org_id | jsonify }}},"mainEntity":[{% for item in site.data.home_faq %}{"@type":"Question","name":{{ item.q | strip_html | normalize_whitespace | strip | jsonify }},"acceptedAnswer":{"@type":"Answer","text":{{ item.a | strip_html | normalize_whitespace | strip | jsonify }}}}{% unless forloop.last %},{% endunless %}{% endfor %}]}
+]}
 </script>
